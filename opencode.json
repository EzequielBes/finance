{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoshare": false,
  "autosummarize": true,
  "model": "openai/codex-mini-latest",

  "provider": {
    "anthropic": {
      "name": "Anthropic",
      "env": "ANTHROPIC_API_KEY"
    },
    "google": {
      "name": "Google",
      "env": "GEMINI_API_KEY"
    },
    "openai": {
      "name": "OpenAI",
      "env": "OPENAI_API_KEY"
    }
  },

  "agent": {
    "enabled": true
  },

  "mcp": {
    "supabase": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--supabase-url", "SUPABASE_URL_PLACEHOLDER",
        "--supabase-key", "SUPABASE_KEY_PLACEHOLDER"
      ]
    }
  }
}
